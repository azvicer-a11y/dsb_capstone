        "               'Rafailovici':'Budva'}\n",
        "real['city'] = real['city'].astype('string').str.strip().replace(aliases)\n",
        "real['city'] = real['city'].where(real['city'].isin(valid_cities))\n",
        "location_text = real['location'].fillna('').astype(str)\n",
        "for name, city_name in {**dict.fromkeys(valid_cities), **aliases, **settlements}.items():\n",
        "    target = city_name if city_name is not None else name\n",
        "    matches = real['city'].isna() & location_text.str.contains(\n",
